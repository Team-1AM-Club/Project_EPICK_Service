{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.epick.local/w2/private-deletion-command-v2.schema.json",
  "title": "PrivateDeletionCommandV2",
  "description": "W2-owned private deletion command with an explicit account or Project scope.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "deletion_id",
    "owner_user_id",
    "deletion_epoch",
    "scope"
  ],
  "properties": {
    "schema_version": {
      "const": "w2.private-deletion.v2",
      "type": "string"
    },
    "deletion_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "owner_user_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "deletion_epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "scope": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "ACCOUNT",
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "project_id"
          ],
          "properties": {
            "type": {
              "const": "PROJECT",
              "type": "string"
            },
            "project_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            }
          }
        }
      ]
    }
  }
}
