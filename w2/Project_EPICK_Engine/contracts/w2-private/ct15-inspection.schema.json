{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "W2 CT15 operator inspection counts (W2 proposal)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "state_counts", "result_payload_count", "visible_result_count", "staged_outbox_count", "staged_payload_count", "pending_staged_count", "ack_count", "pending_ack_count"],
  "properties": {
    "schema_version": {"const": "w2.ct15.inspection.v1"},
    "state_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["STAGED", "PREPARED", "FINALIZED", "ABORTED", "PURGED"],
      "properties": {
        "STAGED": {"$ref": "#/$defs/single"},
        "PREPARED": {"$ref": "#/$defs/single"},
        "FINALIZED": {"$ref": "#/$defs/single"},
        "ABORTED": {"$ref": "#/$defs/single"},
        "PURGED": {"$ref": "#/$defs/single"}
      }
    },
    "result_payload_count": {"$ref": "#/$defs/single"},
    "visible_result_count": {"$ref": "#/$defs/single"},
    "staged_outbox_count": {"$ref": "#/$defs/single"},
    "staged_payload_count": {"$ref": "#/$defs/single"},
    "pending_staged_count": {"$ref": "#/$defs/single"},
    "ack_count": {"type": "integer", "minimum": 0},
    "pending_ack_count": {"type": "integer", "minimum": 0}
  },
  "$defs": {"single": {"type": "integer", "minimum": 0, "maximum": 1}}
}
