{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.epick.local/w1/v1/w2-terminal-cleanup-authority.request.schema.json",
  "title": "W1 decision request for W2 terminal private cleanup",
  "description": "A fresh decision for disposal of an existing owner-bound W2 private row only. It never authorizes new collection, staging, commit-gate application or SQS send.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "owner_user_id", "owner_deletion_epoch", "command_id", "job_id", "execution_fence", "scope", "cleanup_kind"],
  "properties": {
    "schema_version": { "const": "w1.private.w2-terminal-cleanup.v1" },
    "owner_user_id": { "type": "string", "format": "uuid" },
    "owner_deletion_epoch": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
    "command_id": { "type": "string", "format": "uuid" },
    "job_id": { "type": "string", "format": "uuid" },
    "execution_fence": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
    "scope": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["type"], "properties": { "type": { "const": "ACCOUNT" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "project_id"], "properties": { "type": { "const": "PROJECT" }, "project_id": { "type": "string", "format": "uuid" } } }
      ]
    },
    "cleanup_kind": { "enum": ["RESERVATION_RELEASE", "CLAIM_RELEASE", "STAGED_OUTBOX"] }
  }
}
