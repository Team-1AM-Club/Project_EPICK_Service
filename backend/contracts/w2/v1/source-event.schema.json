{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.epick.local/w2/v1/source-event.schema.json",
  "title": "W2 SourceEvent from feat/crawler 0865ecd",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "schema_version", "aggregate_id", "aggregate_revision", "occurred_at", "payload"],
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "event_type": {"type": "string", "enum": ["source.version.available", "source.observation.changed", "source.restriction.changed"]},
    "schema_version": {"const": "w2.source.v1"},
    "aggregate_id": {"type": "string", "format": "uuid"},
    "aggregate_revision": {"type": "integer", "minimum": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "payload": {"oneOf": [{"$ref": "#/$defs/SourceEnvelope"}, {"$ref": "#/$defs/SourceObservationSnapshot"}, {"$ref": "#/$defs/SourceRestrictionSnapshot"}]}
  },
  "allOf": [
    {"if": {"properties": {"event_type": {"const": "source.version.available"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/SourceEnvelope"}}}},
    {"if": {"properties": {"event_type": {"const": "source.observation.changed"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/SourceObservationSnapshot"}}}},
    {"if": {"properties": {"event_type": {"const": "source.restriction.changed"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/SourceRestrictionSnapshot"}}}}
  ],
  "$defs": {
    "DateValue": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "raw_text", "value", "precision", "timezone"],
      "properties": {
        "status": {"type": "string", "enum": ["known", "unknown", "conflicting", "not_applicable"]},
        "raw_text": {"type": ["string", "null"], "minLength": 1},
        "value": {"type": ["string", "null"], "minLength": 1},
        "precision": {"type": ["string", "null"], "enum": ["year", "month", "date", "datetime", null]},
        "timezone": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "Policy": {
      "type": "object", "additionalProperties": false,
      "required": ["policy_decision_id", "official_status", "access_class", "collection_permission", "excerpt_storage_permission", "body_storage_permission", "redistribution_permission", "checked_at", "policy_version"],
      "properties": {
        "policy_decision_id": {"type": "string", "format": "uuid"},
        "official_status": {"type": "string", "enum": ["verified", "unverified", "rejected"]},
        "access_class": {"type": "string", "enum": ["public", "restricted", "unavailable", "unknown"]},
        "collection_permission": {"type": "string", "enum": ["allowed", "denied", "unknown"]},
        "excerpt_storage_permission": {"type": "string", "enum": ["allowed", "denied", "unknown"]},
        "body_storage_permission": {"type": "string", "enum": ["allowed", "denied", "unknown"]},
        "redistribution_permission": {"type": "string", "enum": ["allowed", "denied", "unknown"]},
        "checked_at": {"type": "string", "format": "date-time"},
        "policy_version": {"type": "string", "minLength": 1}
      }
    },
    "Locator": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "value", "normalization_version", "start", "end"],
      "properties": {
        "kind": {"type": "string", "enum": ["css", "xpath", "json_pointer", "normalized_text"]},
        "value": {"type": "string", "minLength": 1},
        "normalization_version": {"type": ["string", "null"], "minLength": 1},
        "start": {"type": ["integer", "null"], "minimum": 0},
        "end": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "Evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "source_version_id", "section_title", "text_excerpt", "locator", "chunk_order"],
      "properties": {
        "evidence_id": {"type": "string", "format": "uuid"},
        "source_version_id": {"type": "string", "format": "uuid"},
        "section_title": {"type": ["string", "null"], "minLength": 1},
        "text_excerpt": {"type": "string", "minLength": 1},
        "locator": {"$ref": "#/$defs/Locator"},
        "chunk_order": {"type": "integer", "minimum": 0}
      }
    },
    "PostingSection": {
      "type": "object", "additionalProperties": false,
      "required": ["section_key", "kind", "heading_raw", "text_raw", "evidence_ids", "order", "relation_text"],
      "properties": {
        "section_key": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "enum": ["title", "role", "organization", "duties", "required", "preferred", "general", "location", "employment_type", "published", "deadline"]},
        "heading_raw": {"type": ["string", "null"], "minLength": 1},
        "text_raw": {"type": "string", "minLength": 1},
        "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "uuid"}},
        "order": {"type": "integer", "minimum": 0},
        "relation_text": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "SourceMetadata": {
      "type": "object", "additionalProperties": false,
      "required": ["representation", "content_type", "normalization_version"],
      "properties": {
        "representation": {"type": "string", "enum": ["static_html", "rendered_html", "official_json"]},
        "content_type": {"type": "string", "minLength": 1},
        "normalization_version": {"type": "string", "minLength": 1}
      }
    },
    "SourceEnvelope": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "source_id", "source_version_id", "extraction_revision_id", "company_id", "source_type", "url_or_path", "title", "policy", "acquisition_status", "extraction_status", "accuracy_status", "freshness_status", "published_at", "collected_at", "checked_at", "valid_from", "valid_to", "content_hash", "hash_profile_version", "parser_version", "language", "evidence_spans", "posting_sections", "retention_scope", "normalized_body_ref", "limitations", "metadata"],
      "properties": {
        "schema_version": {"const": "w2.source.v1"},
        "source_id": {"type": "string", "format": "uuid"},
        "source_version_id": {"type": "string", "format": "uuid"},
        "extraction_revision_id": {"type": "string", "format": "uuid"},
        "company_id": {"type": "string", "format": "uuid"},
        "source_type": {"type": "string", "enum": ["company_website", "job_posting", "press_release", "executive_message", "ir_disclosure", "official_api"]},
        "url_or_path": {"type": "string", "format": "uri", "minLength": 1},
        "title": {"type": ["string", "null"], "minLength": 1},
        "policy": {"$ref": "#/$defs/Policy"},
        "acquisition_status": {"type": "string", "enum": ["AVAILABLE", "PARTIALLY_EXTRACTED"]},
        "extraction_status": {"type": "string", "enum": ["complete", "partial"]},
        "accuracy_status": {"type": "string", "enum": ["unverified", "verified_in_scope", "error_confirmed", "superseded"]},
        "freshness_status": {"type": "string", "enum": ["current", "stale", "unknown"]},
        "published_at": {"$ref": "#/$defs/DateValue"},
        "collected_at": {"type": "string", "format": "date-time"},
        "checked_at": {"type": "string", "format": "date-time"},
        "valid_from": {"$ref": "#/$defs/DateValue"},
        "valid_to": {"$ref": "#/$defs/DateValue"},
        "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "hash_profile_version": {"type": "string", "minLength": 1},
        "parser_version": {"type": "string", "minLength": 1},
        "language": {"type": ["string", "null"], "minLength": 1},
        "evidence_spans": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Evidence"}},
        "posting_sections": {"type": "array", "items": {"$ref": "#/$defs/PostingSection"}},
        "retention_scope": {"type": "string", "enum": ["excerpts_only", "normalized_body"]},
        "normalized_body_ref": {"type": ["string", "null"], "format": "uuid"},
        "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "metadata": {"$ref": "#/$defs/SourceMetadata"}
      }
    },
    "SourceObservationSnapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["observation_id", "source_id", "source_version_id", "policy_decision_id", "observed_at", "access_class", "acquisition_status", "http_status", "checked_url", "error_code", "representation"],
      "properties": {
        "observation_id": {"type": "string", "format": "uuid"},
        "source_id": {"type": "string", "format": "uuid"},
        "source_version_id": {"type": ["string", "null"], "format": "uuid"},
        "policy_decision_id": {"type": ["string", "null"], "format": "uuid"},
        "observed_at": {"type": "string", "format": "date-time"},
        "access_class": {"type": "string", "enum": ["public", "restricted", "unavailable", "unknown"]},
        "acquisition_status": {"type": ["string", "null"], "enum": ["AVAILABLE", "PARTIALLY_EXTRACTED", "ACCESS_DENIED", "NOT_FOUND", "RATE_LIMITED", "EXTRACTION_FAILED", null]},
        "http_status": {"type": ["integer", "null"], "minimum": 100, "maximum": 599},
        "checked_url": {"type": "string", "format": "uri", "minLength": 1},
        "error_code": {"type": ["string", "null"], "minLength": 1},
        "representation": {"type": ["string", "null"], "enum": ["static_html", "rendered_html", "official_json", null]}
      }
    },
    "SourceRestrictionSnapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["restriction_id", "source_id", "source_version_id", "restriction_revision", "restriction_status", "accuracy_status", "reason_code", "changed_at", "replacement_ref"],
      "properties": {
        "restriction_id": {"type": "string", "format": "uuid"},
        "source_id": {"type": "string", "format": "uuid"},
        "source_version_id": {"type": ["string", "null"], "format": "uuid"},
        "restriction_revision": {"type": "integer", "minimum": 1},
        "restriction_status": {"type": "string", "enum": ["active", "cleared"]},
        "accuracy_status": {"type": "string", "enum": ["unverified", "verified_in_scope", "error_confirmed", "superseded"]},
        "reason_code": {"type": "string", "minLength": 1},
        "changed_at": {"type": "string", "format": "date-time"},
        "replacement_ref": {"type": ["string", "null"], "format": "uuid"}
      }
    }
  }
}
