{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.epick.local/w2/private-deletion-command.schema.json",
  "title": "PrivateDeletionCommand",
  "description": "W2-owned private deletion payload accepted only from W1's authenticated private transport.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "deletion_id", "owner_user_id", "deletion_epoch", "attempt_ids", "request_deduplication_ids", "private_reference_keys"],
  "properties": {
    "schema_version": {"const": "w2.private-deletion.v1", "type": "string"},
    "deletion_id": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "owner_user_id": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "deletion_epoch": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "attempt_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"}},
    "request_deduplication_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"}},
    "private_reference_keys": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
