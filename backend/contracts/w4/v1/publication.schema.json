{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "w1.private.w4.recommendation-publication.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "result_origin", "input_data_kind", "run_status",
    "result_status", "limited_analysis", "limitations", "result_version", "candidates",
    "full_result", "source_dependencies"
  ],
  "properties": {
    "schema_version": {"const": "w4-w1-publication/0.1-draft"},
    "run_id": {"type": "string", "format": "uuid"},
    "result_origin": {"const": "ENGINE"},
    "input_data_kind": {"const": "SYNTHETIC"},
    "run_status": {"const": "LIMITED"},
    "result_status": {"const": "LIMITED"},
    "limited_analysis": {"const": true},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "result_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "candidates": {
      "type": "array", "maxItems": 20,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["episode_version_id", "match_status", "short_reason", "validation_status", "result_version", "internal_rank"],
        "properties": {
          "episode_version_id": {"type": "string", "format": "uuid"},
          "match_status": {"enum": ["DIRECT_MATCH", "PARTIAL_RELEVANCE", "NEEDS_VERIFICATION"]},
          "short_reason": {"type": "string", "minLength": 1},
          "strength_summary": {"type": ["string", "null"]},
          "limitation_summary": {"type": ["string", "null"]},
          "validation_status": {"const": "LIMITED"},
          "result_version": {"type": "string", "minLength": 1},
          "internal_rank": {"type": "integer", "minimum": 1}
        }
      }
    },
    "full_result": {"type": "object"},
    "source_dependencies": {"type": "array", "items": {"type": "object"}}
  }
}
