{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.epick.local/w1/v1/w2-gate-scope-lookup.request.schema.json",
  "title": "W1-issued W2 private gate scope lookup request",
  "description": "Resolve the canonical scope of an exact W1-issued gate, including a legacy command with no local W2 stage. This request and its response are not gate-apply or ACK-send authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "owner_user_id", "owner_deletion_epoch", "command_id", "job_id", "execution_fence", "operation_id", "operation_revision", "action", "phase", "result_digest"],
  "properties": {
    "schema_version": { "const": "w1.private.w2-gate-scope-lookup.v1" },
    "owner_user_id": { "type": "string", "format": "uuid" },
    "owner_deletion_epoch": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
    "command_id": { "type": "string", "format": "uuid" },
    "job_id": { "type": "string", "format": "uuid" },
    "execution_fence": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
    "operation_id": { "type": "string", "format": "uuid" },
    "operation_revision": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
    "action": { "enum": ["PREPARE", "FINALIZE", "ABORT", "PURGE"] },
    "phase": { "enum": ["APPLY", "ACK_RELAY"] },
    "result_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "purge_owner_deletion_epoch": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 }
  },
  "allOf": [
    {
      "if": { "properties": { "action": { "const": "PURGE" } } },
      "then": { "required": ["purge_owner_deletion_epoch"] },
      "else": { "not": { "required": ["purge_owner_deletion_epoch"] } }
    }
  ]
}
