{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.epick.local/w1/v1/w2-gate-scope-lookup.response.schema.json",
  "title": "W1-issued W2 private gate canonical scope",
  "description": "Binding information only. W2 must obtain a separate fresh gate-authority decision for APPLY or ACK_RELAY; this response is never a bearer or write grant.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "owner_user_id", "owner_deletion_epoch", "command_id", "job_id", "execution_fence", "operation_id", "operation_revision", "action", "phase", "result_digest", "scope"],
  "properties": {
    "schema_version": { "const": "w1.private.w2-gate-scope-lookup.v1" },
    "owner_user_id": { "type": "string", "format": "uuid" },
    "owner_deletion_epoch": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
    "command_id": { "type": "string", "format": "uuid" },
    "job_id": { "type": "string", "format": "uuid" },
    "execution_fence": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
    "operation_id": { "type": "string", "format": "uuid" },
    "operation_revision": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
    "action": { "enum": ["PREPARE", "FINALIZE", "ABORT", "PURGE"] },
    "phase": { "enum": ["APPLY", "ACK_RELAY"] },
    "result_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "purge_owner_deletion_epoch": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
    "scope": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["type"], "properties": { "type": { "const": "ACCOUNT" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "project_id"], "properties": { "type": { "const": "PROJECT" }, "project_id": { "type": "string", "format": "uuid" } } }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "action": { "const": "PURGE" } } },
      "then": { "required": ["purge_owner_deletion_epoch"] },
      "else": { "not": { "required": ["purge_owner_deletion_epoch"] } }
    }
  ]
}
