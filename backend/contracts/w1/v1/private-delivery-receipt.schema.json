{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.epick.local/w1/v1/private-delivery-receipt.schema.json",
  "title": "EPICK W1 private delivery receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "message_id",
    "consumer",
    "outcome",
    "retryable",
    "error_code",
    "received_at"
  ],
  "properties": {
    "schema_version": {
      "const": "w1.private.receipt.v1"
    },
    "message_id": {
      "type": "string",
      "format": "uuid"
    },
    "payload_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "consumer": {
      "enum": ["w1.collection-result", "w1.core-source-decision"]
    },
    "outcome": {
      "enum": [
        "APPLIED",
        "DUPLICATE",
        "STALE_DISCARDED",
        "REJECTED_SCHEMA",
        "REJECTED_PRINCIPAL",
        "REJECTED_BINDING",
        "REJECTED_CONFLICT",
        "RETRYABLE_INFRA_FAILURE"
      ]
    },
    "retryable": {
      "type": "boolean"
    },
    "error_code": {
      "type": ["string", "null"],
      "maxLength": 64
    },
    "decision_id": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "received_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "consumer": {
            "const": "w1.core-source-decision"
          }
        },
        "required": ["consumer"]
      },
      "then": {
        "required": ["payload_digest", "decision_id"]
      }
    },
    {
      "if": {
        "properties": {
          "consumer": { "const": "w1.core-source-decision" },
          "outcome": { "const": "APPLIED" }
        },
        "required": ["consumer", "outcome"]
      },
      "then": {
        "properties": {
          "decision_id": { "type": "string", "format": "uuid" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "RETRYABLE_INFRA_FAILURE"
          }
        }
      },
      "then": {
        "properties": {
          "retryable": {
            "const": true
          },
          "error_code": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "else": {
        "properties": {
          "retryable": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "APPLIED"
          }
        }
      },
      "then": {
        "properties": {
          "error_code": { "type": "null" }
        }
      },
      "else": {
        "properties": {
          "error_code": { "type": "string", "minLength": 1 }
        }
      }
    }
  ]
}
