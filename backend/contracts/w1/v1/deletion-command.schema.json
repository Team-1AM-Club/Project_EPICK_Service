{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.epick.local/w1/v1/deletion-command.schema.json",
  "title": "EPICK W1 private deletion command v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "command_id",
    "owner_id",
    "owner_deletion_epoch",
    "target_type",
    "target_ref"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "command_id": {
      "type": "string",
      "format": "uuid"
    },
    "owner_id": {
      "type": "string",
      "format": "uuid"
    },
    "owner_deletion_epoch": {
      "type": "integer",
      "minimum": 1
    },
    "target_type": {
      "enum": [
        "POSTGRESQL",
        "CHECKPOINT",
        "CACHE",
        "NEO4J",
        "VECTOR"
      ]
    },
    "target_ref": {
      "type": "string",
      "format": "uuid"
    }
  }
}
