{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.epick.local/w1/v1/private-command-lookup-response.schema.json",
  "title": "EPICK W1 protected command lookup response v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "command_id",
    "status",
    "command"
  ],
  "properties": {
    "schema_version": {
      "const": "w1.private.command-lookup.v1"
    },
    "command_id": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "const": "AVAILABLE"
    },
    "command": {
      "type": "object"
    }
  }
}
