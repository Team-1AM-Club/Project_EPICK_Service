{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:epick:w1-private:w3-analysis-plan-command:1.0",
  "title": "W1 to W3 AnalysisPlan command",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "command_id",
    "job_id",
    "analysis_request_id",
    "company_id",
    "analysis_input_version",
    "execution_fence",
    "owner_deletion_epoch",
    "required_sources",
    "optional_sources",
    "issued_at",
    "expires_at",
    "idempotency_key",
    "canonical_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "w1.private.w3.analysis-plan/1.0"
    },
    "command_id": { "$ref": "#/$defs/uuid" },
    "job_id": { "$ref": "#/$defs/uuid" },
    "analysis_request_id": { "$ref": "#/$defs/uuid" },
    "company_id": { "$ref": "#/$defs/uuid" },
    "question_id": {
      "oneOf": [
        { "$ref": "#/$defs/uuid" },
        { "type": "null" }
      ]
    },
    "question_version_id": {
      "oneOf": [
        { "$ref": "#/$defs/uuid" },
        { "type": "null" }
      ]
    },
    "analysis_input_version": { "$ref": "#/$defs/nonempty" },
    "execution_fence": { "type": "integer", "minimum": 1 },
    "owner_deletion_epoch": { "type": "integer", "minimum": 0 },
    "required_sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/sourceRef" }
    },
    "optional_sources": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/sourceRef" }
    },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "idempotency_key": { "$ref": "#/$defs/nonempty" },
    "canonical_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "nonempty": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_version_id",
        "decision_id",
        "decision_version",
        "purpose"
      ],
      "properties": {
        "source_id": { "$ref": "#/$defs/uuid" },
        "source_version_id": { "$ref": "#/$defs/uuid" },
        "decision_id": { "$ref": "#/$defs/uuid" },
        "decision_version": { "type": "integer", "minimum": 1 },
        "purpose": { "$ref": "#/$defs/nonempty" }
      }
    }
  }
}
