{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:epick:deployment-manifest:1.0",
  "title": "EPICK multi-component deployment manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "environment",
    "status",
    "policy_manifest_revision",
    "components",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": "epick.deployment/1.0" },
    "release_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "environment": { "enum": ["local-e2e", "staging", "production"] },
    "status": {
      "enum": [
        "DRAFT",
        "LOCAL_E2E_PASSED",
        "BUILT",
        "AWS_PREFLIGHT_PASSED",
        "STAGING_E2E_PASSED",
        "RELEASE_CANDIDATE"
      ]
    },
    "policy_manifest_revision": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "components": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/component" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^(sha256:)?[0-9a-f]{64}$"
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "repository",
        "source_sha",
        "lock_hash",
        "contract_hashes",
        "artifact",
        "entrypoints",
        "health_probe",
        "rollback_artifact"
      ],
      "properties": {
        "name": { "enum": ["frontend", "w1", "w2", "w3", "w4"] },
        "repository": { "type": "string", "minLength": 1 },
        "source_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "lock_hash": { "$ref": "#/$defs/sha256" },
        "contract_hashes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sha256" }
        },
        "migration_head": { "type": ["string", "null"] },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "immutable_id"],
          "properties": {
            "kind": { "enum": ["oci-image", "vercel-deployment"] },
            "immutable_id": { "type": "string", "minLength": 1 }
          }
        },
        "entrypoints": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "health_probe": { "type": "string", "minLength": 1 },
        "writable_state": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "identity_ref": { "type": ["string", "null"] },
        "config_revision": { "type": ["string", "null"] },
        "rollback_artifact": { "type": "string", "minLength": 1 }
      }
    }
  }
}
