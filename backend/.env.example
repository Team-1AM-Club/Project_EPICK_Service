# Set DATABASE_URL at runtime. A container connecting to another container must
# use that database service's hostname rather than localhost.
APP_ENV=local
DATABASE_URL=postgresql+psycopg://epick:epick_2026_local@localhost:5432/epick_local
# Set only for an explicit Alembic invocation with the migration principal. The API and workers
# must use DATABASE_URL and never run migrations during startup.
MIGRATION_DATABASE_URL=
TEST_DATABASE_URL=postgresql+psycopg://epick:epick_2026_local@localhost:5432/epick_test
# Required in staging/production for every cursor-backed list endpoint. Keep this in a
# dedicated application secret; do not derive it from a database password.
API_CURSOR_SIGNING_KEY=
API_IDEMPOTENCY_TTL_SECONDS=86400
# Browser authentication. Values below are placeholders only; never commit real
# OAuth credentials, signing material, or refresh peppers.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OIDC_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
GOOGLE_OIDC_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration
EPICK_AUTH_ISSUER=http://localhost:8000
EPICK_AUTH_AUDIENCE=epick-public-api
EPICK_AUTH_SIGNING_KEY=
EPICK_REFRESH_TOKEN_PEPPER=
EPICK_ACCESS_TOKEN_TTL_SECONDS=900
EPICK_REFRESH_TOKEN_TTL_SECONDS=2592000
EPICK_OIDC_TRANSACTION_TTL_SECONDS=600
EPICK_FRONTEND_URL=http://localhost:3001
EPICK_ALLOWED_FRONTEND_ORIGINS=["http://localhost:3001"]
EPICK_AUTH_COOKIE_SECURE=false
# W1 relay is a separate runtime process.  The execution queue URL is supplied by the W1
# runtime IaC output; leave it empty for API-only local development.
W1_JOB_EXECUTION_QUEUE_URL=
W1_OUTBOX_RELAY_INSTANCE_ID=
W1_OUTBOX_RELAY_BATCH_SIZE=10
W1_OUTBOX_RELAY_LEASE_SECONDS=120
W1_OUTBOX_RELAY_POLL_SECONDS=2
W1_OUTBOX_RELAY_RETRY_BASE_SECONDS=5
W1_OUTBOX_RELAY_RETRY_MAX_SECONDS=300
# W1-only durable commit-gate recovery.  This process needs WORKER_DATABASE_URL,
# but does not receive W2 ACK credentials or a public listener.
W1_COMMIT_GATE_RECOVERY_BATCH_SIZE=100
W1_COMMIT_GATE_RECOVERY_POLL_SECONDS=5
# Runtime-only values.  Do not place the API URL, lookup/worker URL, or bearer token in the
# same Secret.  R-3 injects these into the private runtime host only.
WORKER_DATABASE_URL=
DELETION_WORKER_DATABASE_URL=
LOOKUP_DATABASE_URL=
W2_COLLECTION_COMMAND_QUEUE_URL=
W2_COLLECTION_RESULT_QUEUE_URL=
W1_WORKER_ID=
W1_SQS_VISIBILITY_SECONDS=120
W1_SQS_LONG_POLL_SECONDS=20
W1_LEASE_HEARTBEAT_SECONDS=60
W1_WORKER_POLL_SECONDS=2
W1_W2_LOOKUP_BEARER=
# Private W3 Core Decision consumer. EXPECTED_SENDER_ID is the stable IAM role ID
# before the colon in the SQS SenderId system attribute, not a role ARN or session name.
W3_CORE_DECISION_QUEUE_URL=
W3_CORE_DECISION_DLQ_URL=
W3_CORE_DECISION_EXPECTED_PRODUCER=w3
W3_CORE_DECISION_EXPECTED_SENDER_ID=
W3_CORE_DECISION_BATCH_SIZE=10
W3_CORE_DECISION_WAIT_SECONDS=20
W3_CORE_DECISION_VISIBILITY_SECONDS=120
# Dedicated Standard SQS retention command/receipt paths. Role IDs are stable
# STS principal IDs without the session suffix and must come from a secret channel.
W3_RETENTION_COMMAND_QUEUE_URL=
W3_RETENTION_RECEIPT_QUEUE_URL=
W3_RETENTION_RECEIPT_DLQ_URL=
W3_RETENTION_W1_STABLE_ROLE_ID=
W3_RETENTION_EXPECTED_W3_SENDER_ID=
W3_RETENTION_RECEIPT_BATCH_SIZE=10
W3_RETENTION_RECEIPT_WAIT_SECONDS=20
W3_RETENTION_RECEIPT_VISIBILITY_SECONDS=120
# W1 private Authority for W3. Configure URL/database/bearer as one set only
# after W3-B adoption. Use a dedicated column-minimal read-only DB login.
W3_AUTHORITY_PRIVATE_URL=
W3_AUTHORITY_DATABASE_URL=
W3_AUTHORITY_PRIVATE_BEARER=
W3_AUTHORITY_EXPECTED_PRINCIPAL=epick-w3-core-runtime
W3_AUTHORITY_CONNECT_TIMEOUT_SECONDS=1
W3_AUTHORITY_READ_TIMEOUT_SECONDS=2
W3_AUTHORITY_TOTAL_TIMEOUT_SECONDS=5
# W1 -> W4 recommendation execution. This is not the W4 Question Core path.
# Keep SYNTHETIC until the isolated acceptance gate is complete. ENGINE requires
# all queue/private HTTP values; REAL remains fail-closed in Stage 4.5.
W1_RECOMMENDATION_EXECUTION_MODE=SYNTHETIC
W4_RECOMMENDATION_EXECUTION_QUEUE_URL=
W4_RECOMMENDATION_EXECUTION_DLQ_URL=
W4_RECOMMENDATION_PRIVATE_BASE_URL=
W4_RECOMMENDATION_PRIVATE_BEARER=
W4_RECOMMENDATION_PRIVATE_AUDIENCE=epick-w4-recommendation-worker
W4_RECOMMENDATION_ENGINE_SOURCE_REVISION=df41433218918e4167784243dc9b88e5a858278d
W4_RECOMMENDATION_SCHEMA_MANIFEST_SHA256=sha256:bf69d0f6b10bbeeb2cded79788758fa800b148782e19347edcae44ad12a460d3
W4_RECOMMENDATION_LEASE_SECONDS=300
W4_RECOMMENDATION_REQUEST_TIMEOUT_SECONDS=30
W4_RECOMMENDATION_VISIBILITY_SECONDS=600
W4_RECOMMENDATION_HEARTBEAT_SECONDS=60
W4_RECOMMENDATION_MAX_RECEIVES=5
W4_RECOMMENDATION_REAL_DATA_ENABLED=false
W4_RECOMMENDATION_SYNTHETIC_ACCEPTANCE=NO
