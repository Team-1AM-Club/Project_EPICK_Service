# EPICK full-service local integration template.
# Copy to an ignored .runtime path and replace only SET_* placeholders.
# Secrets and endpoint values belong in the referenced component env files.

INTEGRATION_ENABLED=true
INTEGRATION_REAL_DATA_ENABLED=false
INTEGRATION_POLICY_REVISION=SET_APPROVED_POLICY_REVISION
INTEGRATION_CONTRACT_PINS=SET_CONTRACT_PIN_JSON

DEPLOYMENT_MANIFEST_FILE=SET_LOCAL_FILE
POLICY_MANIFEST_FILE=SET_LOCAL_FILE
EVIDENCE_OUTPUT_DIR=SET_LOCAL_DIRECTORY

W1_RUNTIME_ENV_FILE=SET_LOCAL_FILE
W1_LOOKUP_ENV_FILE=SET_LOCAL_FILE
W2_RUNTIME_ENV_FILE=SET_LOCAL_FILE
W3_RUNTIME_ENV_FILE=SET_LOCAL_FILE
W4_RUNTIME_ENV_FILE=SET_LOCAL_FILE

W1_RDS_CA_FILE=SET_LOCAL_FILE
W2_RDS_CA_FILE=SET_LOCAL_FILE
W1_LOOKUP_CA_FILE=SET_LOCAL_FILE
W3_AUTHORITY_CA_FILE=SET_LOCAL_FILE
W4_RUNTIME_CA_FILE=SET_LOCAL_FILE

INTEGRATION_W2_PRIVATE_ORIGIN=SET_PRIVATE_ORIGIN
INTEGRATION_W3_PRIVATE_ORIGIN=SET_PRIVATE_ORIGIN
INTEGRATION_W4_PRIVATE_ORIGIN=SET_PRIVATE_ORIGIN
